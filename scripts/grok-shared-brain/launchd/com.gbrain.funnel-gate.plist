<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gbrain.funnel-gate</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>__REPO__/scripts/grok-shared-brain/cli-gate.ts</string>
    <string>--tokens</string>
    <string>__HOME__/.gbrain/serve/funnel-tokens.json</string>
    <string>--upstream</string>
    <string>http://127.0.0.1:8766</string>
    <string>--port</string>
    <string>8767</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/com.gbrain.funnel-gate.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/com.gbrain.funnel-gate.err</string>
</dict>
</plist>
