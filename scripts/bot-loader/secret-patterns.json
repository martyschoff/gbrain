{
  "description": "Single secret-skip list for scripts/bot-loader/secrets.ts and scripts/bot-loader/secret_rules.py. A match skips the whole file. Nothing from that file is copied or redacted into a page body.",
  "names": [
    { "source": "^\\.env(?:\\.|$)", "flags": "i", "sample": ".env" },
    { "source": "\\.env$", "flags": "i", "sample": "prod.env" },
    { "source": "^config\\.env$", "flags": "i", "sample": "config.env" },
    { "source": "^\\.envrc$", "flags": "i", "sample": ".envrc" },
    { "source": "^auth\\.json$", "flags": "i", "sample": "auth.json" },
    { "source": "id_rsa", "flags": "i", "sample": "id_rsa" },
    { "source": "id_ed25519", "flags": "i", "sample": "id_ed25519" },
    { "source": "id_ecdsa", "flags": "i", "sample": "id_ecdsa.pub" },
    { "source": "id_dsa", "flags": "i", "sample": "id_dsa" },
    { "source": "token", "flags": "i", "sample": "api-token.txt" },
    { "source": "secret", "flags": "i", "sample": "top-secret.txt" },
    { "source": "credential", "flags": "i", "sample": "credential.txt" },
    { "source": "\\.pem$", "flags": "i", "sample": "server.pem" },
    { "source": "\\.key$", "flags": "i", "sample": "server.key" },
    { "source": "\\.p12$", "flags": "i", "sample": "store.p12" },
    { "source": "\\.pfx$", "flags": "i", "sample": "store.pfx" },
    { "source": "-key\\.json$", "flags": "i", "sample": "account-key.json" },
    { "source": "^service-account.*\\.json$", "flags": "i", "sample": "service-account.json" },
    { "source": "^credentials.*\\.json$", "flags": "i", "sample": "credentials-live.json" },
    { "source": "^\\.netrc$", "flags": "i", "sample": ".netrc" },
    { "source": "^\\.npmrc$", "flags": "i", "sample": ".npmrc" },
    { "source": "^\\.pypirc$", "flags": "i", "sample": ".pypirc" }
  ],
  "content": [
    { "source": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----", "flags": "", "sample": "-----BEGIN OPENSSH PRIVATE KEY-----\n" },
    { "source": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----", "flags": "", "sample": "-----BEGIN EC PRIVATE KEY-----\n" },
    { "source": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----", "flags": "", "sample": "-----BEGIN PRIVATE KEY-----\n" },
    { "source": "sk-ant-[A-Za-z0-9_-]{16,}", "flags": "", "sample": "sk-ant-api03-FAKEFAKEFAKEFAKE" },
    { "source": "sk-proj-[A-Za-z0-9_-]{16,}", "flags": "", "sample": "sk-proj-FAKEFAKEFAKEFAKEFAKE" },
    { "source": "\\bsk-[A-Za-z0-9]{16,}", "flags": "", "sample": "sk-FAKEFAKEFAKEFAKE" },
    { "source": "github_pat_[A-Za-z0-9_]{16,}", "flags": "", "sample": "github_pat_FAKEFAKEFAKEFAKEFAKE" },
    { "source": "\\bgh[opsu]_[A-Za-z0-9_]{16,}", "flags": "", "sample": "gho_FAKEFAKEFAKEFAKE" },
    { "source": "\\bgh[opsu]_[A-Za-z0-9_]{16,}", "flags": "", "sample": "ghp_FAKEFAKEFAKEFAKE" },
    { "source": "\\bgh[opsu]_[A-Za-z0-9_]{16,}", "flags": "", "sample": "ghs_FAKEFAKEFAKEFAKE" },
    { "source": "\\bgh[opsu]_[A-Za-z0-9_]{16,}", "flags": "", "sample": "ghu_FAKEFAKEFAKEFAKE" },
    { "source": "\\bglpat-[A-Za-z0-9_-]{16,}", "flags": "", "sample": "glpat-FAKEFAKEFAKEFAKE" },
    { "source": "\\bxox[a-z]-[A-Za-z0-9-]{10,}", "flags": "i", "sample": "xoxb-FAKEFAKEFAKE" },
    { "source": "\\bxox[a-z]-[A-Za-z0-9-]{10,}", "flags": "i", "sample": "xoxp-FAKEFAKEFAKE" },
    { "source": "\\bxox[a-z]-[A-Za-z0-9-]{10,}", "flags": "i", "sample": "xoxs-FAKEFAKEFAKE" },
    { "source": "\\bxox[a-z]-[A-Za-z0-9-]{10,}", "flags": "i", "sample": "xoxa-FAKEFAKEFAKE" },
    { "source": "\\bxox[a-z]-[A-Za-z0-9-]{10,}", "flags": "i", "sample": "xoxe-FAKEFAKEFAKE" },
    { "source": "\\bxox[a-z]-[A-Za-z0-9-]{10,}", "flags": "i", "sample": "xoxr-FAKEFAKEFAKE" },
    { "source": "\\bAKIA[0-9A-Z]{16}\\b", "flags": "", "sample": "AKIAFAKEFAKEFAKE1234" },
    { "source": "(?:aws_secret_access_key|\\bsecret)\\s*[=:,]\\s*['\"]?[A-Za-z0-9+/]{40}={0,2}", "flags": "i", "sample": "aws_secret_access_key=0123456789012345678901234567890123456789" },
    { "source": "(?:aws_secret_access_key|\\bsecret)\\s*[=:,]\\s*['\"]?[A-Za-z0-9+/]{40}={0,2}", "flags": "i", "sample": "secret: 0123456789012345678901234567890123456789" },
    { "source": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+", "flags": "", "sample": "eyJhbGciOiJub25lIn0.eyJzdWIiOiJ0ZXN0In0.signaturevalue" },
    { "source": "https://hooks\\.slack\\.com/services/[A-Za-z0-9]+/[A-Za-z0-9]+/[A-Za-z0-9]+", "flags": "i", "sample": "https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX" },
    { "source": "https://(?:discord\\.com|discordapp\\.com)/api/webhooks/[0-9]+/[A-Za-z0-9_-]+", "flags": "i", "sample": "https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz" },
    { "source": "https://(?:discord\\.com|discordapp\\.com)/api/webhooks/[0-9]+/[A-Za-z0-9_-]+", "flags": "i", "sample": "https://discordapp.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz" },
    { "source": "aws_secret_access_key\\s*[=,]", "flags": "i", "sample": "aws_secret_access_key,placeholder" },
    { "source": "(?:^|[\\n,])\\s*password\\s*[:=]\\s*\\S", "flags": "i", "sample": "password=not-a-real-value" },
    { "source": "(?:^|[\\n,])\\s*password\\s*[:=]\\s*\\S", "flags": "i", "sample": "password: not-a-real-value" },
    { "source": "(?:^|[\\n,])\\s*(?:[A-Za-z0-9]+_)?(?:api[_-]?key|access[_-]?token)\\s*[=:]\\s*(\\S+)", "flags": "i", "sample": "api_key=not-a-real-value", "allow_placeholders": true },
    { "source": "\\bbearer\\s+[A-Za-z0-9\\-._~+/]{20,}={0,2}", "flags": "i", "sample": "Bearer abcdefghijklmnopqrstuvwxyz" }
  ],
  "name_negatives": ["notes.txt", "readme.md", "meeting-notes.md"],
  "content_negatives": [
    "The token in this sentence is a word, not a credential.",
    "We agreed the secret plan stays offline.",
    "password policy lives in the handbook",
    "The api key is rotated quarterly.",
    "sk-ant-short",
    "eyJ is just three characters"
  ]
}
